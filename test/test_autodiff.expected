import triton
import triton.language as tl
from helion.runtime import default_launcher as _default_launcher

_BLOCK_SIZE_0 = tl.constexpr(1)

@triton.jit
def _helion_backward_kernel(grad_out, x, grad_x, _RDIM_SIZE_1: tl.constexpr):
    # src[helion_bwd_4caff8dfca9e.py:N]: for tile in hl.tile(grad_out.shape):
    pid_0 = tl.program_id(0)
    offset_0 = pid_0
    indices_0 = offset_0 + tl.zeros([1], tl.int32)
    indices_1 = tl.arange(0, _RDIM_SIZE_1).to(tl.int32)
    # src[helion_bwd_4caff8dfca9e.py:N]: grad_out_tile = grad_out[tile]
    grad_out_tile = tl.load(grad_out + indices_0 * 1, None)
    # src[helion_bwd_4caff8dfca9e.py:N]: x_tile = x[tile, :]
    x_tile = tl.load(x + (indices_0[:, None] * 512 + indices_1[None, :] * 1), None)
    # src[helion_bwd_4caff8dfca9e.py:N]: unsqueeze_val = grad_out_tile.view(grad_out_tile.shape[0], 1)
    unsqueeze_val = tl.reshape(grad_out_tile, [_BLOCK_SIZE_0, 1])
    # src[helion_bwd_4caff8dfca9e.py:N]: expand_val = unsqueeze_val.expand_as(x_tile)
    expand_val = tl.broadcast_to(unsqueeze_val, [_BLOCK_SIZE_0, _RDIM_SIZE_1])
    # src[helion_bwd_4caff8dfca9e.py:N]: grad_x[tile, :] = expand_val
    tl.store(grad_x + (indices_0[:, None] * 512 + indices_1[None, :] * 1), expand_val, None)

def backward_kernel(grad_out: torch.Tensor, x: torch.Tensor, *, _launcher=_default_launcher):
    # src[helion_bwd_4caff8dfca9e.py:N]: grad_x = torch.empty_like(x)
    grad_x = torch.empty_like(x)
    # src[helion_bwd_4caff8dfca9e.py:N]: for tile in hl.tile(grad_out.shape):
    _RDIM_SIZE_1 = 512
    # src[helion_bwd_4caff8dfca9e.py:N]: for tile in hl.tile(grad_out.shape):
    # src[helion_bwd_4caff8dfca9e.py:N]:     grad_out_tile = grad_out[tile]
    # src[helion_bwd_4caff8dfca9e.py:N]:     x_tile = x[tile, :]
    # src[helion_bwd_4caff8dfca9e.py:N-N]: ...
    _launcher(_helion_backward_kernel, (1024,), grad_out, x, grad_x, _RDIM_SIZE_1, num_warps=4, num_stages=1)
    # src[helion_bwd_4caff8dfca9e.py:N]: return grad_x
    return grad_x

