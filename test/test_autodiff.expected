"""
Auto-generated Helion backward kernel.
"""

import torch
import helion
from helion import language as hl

@helion.kernel()
def backward_kernel(grad_out: torch.Tensor, x: torch.Tensor, y: torch.Tensor) -> tuple[torch.Tensor, ...]:
    grad_x = torch.empty_like(x)
    grad_y = torch.empty_like(y)
    for tile in hl.tile(grad_out.shape):
        grad_out_tile = grad_out[tile]
        x_tile = x[tile, :]
        y_tile = y[tile, :]
        unsqueeze_val = grad_out_tile.view(grad_out_tile.shape[0], 1)
        expand_val = unsqueeze_val.expand_as(x_tile)
        mul_1_val = torch.mul(expand_val, x_tile)
        mul_2_val = torch.mul(expand_val, y_tile)
        grad_x[tile, :] = mul_2_val
        grad_y[tile, :] = mul_1_val
    return (grad_x, grad_y)

