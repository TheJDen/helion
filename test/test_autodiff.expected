--- assertExpectedJournal(TestAutodiff.test_amax_reduction)
"""
Auto-generated Helion backward kernel.
"""

import torch
import helion
from helion import language as hl

@helion.kernel()
def backward_kernel(grad_out: torch.Tensor, x: torch.Tensor) -> torch.Tensor:
    grad_x = torch.empty_like(x)
    for tile in hl.tile(grad_out.shape):
        grad_out_tile = grad_out[tile]
        x_tile = x[tile, :]
        view_1_val = grad_out_tile.view(x_tile.shape[0], 1)
        amax_val = torch.amax(x_tile, [1])
        view_val = amax_val.view(x_tile.shape[0], 1)
        eq_val = torch.eq(view_val, x_tile)
        sum_1_cast = eq_val.to(torch.int64)
        sum_1_val = torch.sum(sum_1_cast, [1], True)
        div_val = torch.div(view_1_val, sum_1_val)
        mul_val = torch.mul(div_val, eq_val)
        grad_x[tile, :] = mul_val
    return grad_x

