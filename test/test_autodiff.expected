    # src[helion_bwd_817d58d2593f.py:N]: mul_1_val = torch.mul(grad_out_tile, sub_val)
    v_4 = grad_out_tile * v_3
    # src[helion_bwd_817d58d2593f.py:N]: grad_x[tile] = mul_1_val
    tl.store(grad_x + indices_0 * 1, v_4, None)

