        # src[helion_bwd_c6b53b9d8c7b.py:N]:     acc = torch.baddbmm(acc, grad_out[tile_b, tile_m, tile_n], b[tile_b, tile_k, tile_n].permute(0, 2, 1))
        for offset_3 in tl.range(0, 48, _BLOCK_SIZE_3):
            indices_3 = offset_3 + tl.arange(0, _BLOCK_SIZE_3).to(tl.int32)
            acc_copy = acc
            acc_copy_0 = acc_copy
            # src[helion_bwd_c6b53b9d8c7b.py:N]: acc = torch.baddbmm(acc, grad_out[tile_b, tile_m, tile_n], b[tile_b, tile_k, tile_n].permute(0, 2, 1))
            load = tl.load(grad_out + (indices_0[:, None, None] * 1536 + indices_1[None, :, None] * 48 + indices_3[None, None, :] * 1), None)
            load_1 = tl.load(b + (indices_0[:, None, None] * 3072 + indices_2[None, :, None] * 48 + indices_3[None, None, :] * 1), None)
            permute = tl.permute(load_1, [0, 2, 1])
            acc = tl.reshape(tl.dot(tl.reshape(tl.cast(load, tl.float32), [_BLOCK_SIZE_1, _BLOCK_SIZE_3]), tl.reshape(tl.cast(permute, tl.float32), [_BLOCK_SIZE_3, _BLOCK_SIZE_2]), acc=tl.reshape(acc_copy_0, [_BLOCK_SIZE_1, _BLOCK_SIZE_2]), input_precision='tf32', out_dtype=tl.float32), [_BLOCK_SIZE_0, _BLOCK_SIZE_1, _BLOCK_SIZE_2])
