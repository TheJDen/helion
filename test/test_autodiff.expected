            load_2 = tl.load(a + (indices_4[:, None, None] * 2048 + indices_7[None, :, None] * 64 + indices_5[None, None, :] * 1), None)
            permute_1 = tl.permute(load_2, [0, 2, 1])
            load_3 = tl.load(grad_out + (indices_4[:, None, None] * 1536 + indices_7[None, :, None] * 48 + indices_6[None, None, :] * 1), None)
            acc2 = tl.reshape(tl.dot(tl.reshape(tl.cast(permute_1, tl.float32), [_BLOCK_SIZE_5, _BLOCK_SIZE_7]), tl.reshape(tl.cast(load_3, tl.float32), [_BLOCK_SIZE_7, _BLOCK_SIZE_6]), acc=tl.reshape(acc2_copy_0, [_BLOCK_SIZE_5, _BLOCK_SIZE_6]), input_precision='tf32', out_dtype=tl.float32), [_BLOCK_SIZE_4, _BLOCK_SIZE_5, _BLOCK_SIZE_6])
