        tl.store(grad_b + (indices_4[:, None, None] * 3072 + indices_5[None, :, None] * 48 + indices_6[None, None, :] * 1), acc2, None)

def backward_kernel(grad_out: torch.Tensor, a: torch.Tensor, b: torch.Tensor, *, _launcher=_default_launcher):
    # src[helion_bwd_c6b53b9d8c7b.py:N]: batch, m, k = a.shape
